# Transport for NSW Open Data API key (https://opendata.transport.nsw.gov.au/)
# Subscribe the application to "Trip Planner APIs" and "Live Traffic Hazards".
TFNSW_API_KEY=

# Default commute (address, place, station name, TfNSW stop id, or "lat,lon").
HOME_ADDRESS=Parramatta Station
WORK_ADDRESS=Wynyard Station

# Optional: Google Routes API key for traffic-aware driving times.
# When unset, driving time is estimated from OSRM free-flow time, a Sydney
# time-of-day congestion profile and live TfNSW hazards on the route.
GOOGLE_MAPS_API_KEY=

# Optional: override the OSRM routing server (default: public demo server).
# OSRM_URL=https://router.project-osrm.org

# Port for the web interface.
PORT=3000

# Set to 1 to run with simulated data (no API keys or network required).
DEMO=0
